generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                @id @default(cuid())
  pseudo        String                @unique
  email         String                @unique
  password      String
  publicProfile Boolean               @default(true)
  createdAt     DateTime              @default(now())
  dex           DexEntry[]
  achievements  UnlockedAchievement[]
}

model Manhole {
  manholeNo  String     @id
  name       String
  prefName   String
  prefEnName String
  city       String
  address    String
  lat        Float
  lng        Float
  pictureUrl String
  pokemon    Json
  dexEntries DexEntry[]
}

model DexEntry {
  userId    String
  manholeNo String
  visitedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  manhole   Manhole  @relation(fields: [manholeNo], references: [manholeNo])

  @@id([userId, manholeNo])
  @@index([userId])
}

/// Persisted "sticky" achievement unlock — once a row exists, the badge stays
/// earned even if the user later unmarks visits or the threshold definition
/// changes. Inserted lazily on the first /me/achievements read after eligibility.
model UnlockedAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@index([userId])
}

/// Static catalogue of every Pokemon featured on a manhole cover. Populated
/// once by prisma/enrich-pokemon.ts using PokeAPI. Names match exactly what
/// appears in Manhole.pokemon JSON so they can be joined by name.
model Pokemon {
  name        String   @id
  /// PokeAPI numeric id. Not unique — the source data contains two
  /// near-duplicate names per species ("Farfetch'd" vs "Farfetch’d", straight
  /// vs curly apostrophe) which both resolve to the same PokeAPI entity.
  pokeApiId   Int
  /// Lowercase PokeAPI type slugs, e.g. ["water", "psychic"].
  types       String[]
  isLegendary Boolean  @default(false)
  isMythical  Boolean  @default(false)
  generation  Int      @default(0)

  @@index([pokeApiId])
}
